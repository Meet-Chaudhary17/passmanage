# -----------------------------------------------------------------------------
# PassManage Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS. Copy this file to .env and generate real keys.
# -----------------------------------------------------------------------------

PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/passmanage

# Generate 32-byte hex keys using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=<GENERATE_RANDOM_64_CHAR_HEX_KEY>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=<GENERATE_RANDOM_64_CHAR_HEX_KEY>
REFRESH_TOKEN_EXPIRES_IN=7d
EXTENSION_JWT_SECRET=<GENERATE_RANDOM_64_CHAR_HEX_KEY>
EXTENSION_JWT_EXPIRES_IN=30m

VAULT_MASTER_KEY=<GENERATE_RANDOM_32_BYTE_HEX_VAULT_KEY>
BIOMETRIC_ENCRYPTION_KEY=<GENERATE_RANDOM_32_BYTE_HEX_BIOMETRIC_KEY>
INTERNAL_SERVICE_KEY=<GENERATE_RANDOM_32_BYTE_HEX_INTERNAL_KEY>

# Python Face Service (Bound to 127.0.0.1)
FACE_SERVICE_URL=http://127.0.0.1:8000
FACE_DISTANCE_METRIC=cosine
FACE_VERIFICATION_THRESHOLD=0.68

# WebAuthn Configuration (FIDO2 Localhost)
FRONTEND_URL=http://localhost:5173
RP_NAME="PassManage Local Vault"
RP_ID=localhost
ORIGIN=http://localhost:5173
